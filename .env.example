NODE_ENV=development
DATABASE_URL=postgresql://daery:daery@localhost:5432/daery
# Gere um valor aleatório com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Número de proxies reversos na frente da API (0 = acesso direto, 1 = atrás de Nginx, por ex.)
TRUST_PROXY=0
BCRYPT_SALT_ROUNDS=10
AUTH_RATE_LIMIT_MAX=10
# Versão do texto de consentimento do cadastro; troque quando o texto mudar
TERMS_VERSION=2026-10-15
# Usuário ADMIN inicial criado por `npx prisma db seed`
SEED_ADMIN_NAME=Administrador Daery
SEED_ADMIN_EMAIL=admin@daery.local
SEED_ADMIN_PASSWORD=change-me-admin-password
# true insere os registros fictícios do pacote de banco da equipe (fonte marcada [FICTÍCIO])
SEED_DEMO_DATA=false
# Integração com o InfoDengue
INFODENGUE_BASE_URL=https://info.dengue.mat.br
INFODENGUE_TIMEOUT_MS=15000
INFODENGUE_SYNC_WEEKS=12
# 0 = sem sincronização automática; ex.: 24 = uma vez por dia
INFODENGUE_SYNC_INTERVAL_HOURS=0
